# Sample production settings. Do not copy this file to .env or .env.production.
# Set the variable in the build environment and replace the placeholder below.
# Local development uses .env.example instead.

# Public origin of the Express API, with HTTPS and no path. It must be on the same site as the
# client (for example app.example.com and api.example.com) so the session cookie works.
# Next.js writes NEXT_PUBLIC_* values into the browser code when the app is built, so this must be
# set at build time. Changing it later needs a new build.
NEXT_PUBLIC_AUTH_URL=https://api.example.com
