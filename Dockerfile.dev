# Development image for the Ekam client. Source code is bind-mounted at runtime
# (see the root docker-compose.yml), so only dependencies are baked in here.
FROM node:24-slim

WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci && node -e "const fs=require('fs'),c=require('crypto'); fs.writeFileSync('node_modules/.ekam-lock-hash', c.createHash('sha256').update(fs.readFileSync('package-lock.json')).digest('hex'))"

COPY . .

ENTRYPOINT ["node", "docker-entrypoint.mjs"]

# The port comes from the PORT environment variable set by Compose.
# Listen on all interfaces so the host can reach the dev server.
# --webpack because Turbopack ignores file polling, which is needed on Windows.
CMD ["npm", "run", "dev", "--", "--webpack", "--hostname", "0.0.0.0"]
